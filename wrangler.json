{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kide",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "kide.us",
      "custom_domain": true
    },
    {
      "pattern": "www.kide.us",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domains-db",
      "database_id": "b41e909b-ad01-4fd5-84ca-d8d014706942"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KIDE_LEADS",
      "id": "5798aa0569ce449aa818bdc3f6533f63"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MODELS",
      "bucket_name": "kide-models"
    }
  ],
  "services": [
    {
      "binding": "PORTFOLIO_AI_SERVICE",
      "service": "riskfreetrial",
      "entrypoint": "PortfolioAIService",
      "remote": true
    },
    {
      "binding": "PORTFOLIO_BILLING_SERVICE",
      "service": "riskfreetrial",
      "entrypoint": "PortfolioBillingService",
      "remote": true
    },
    {
      "binding": "PORTFOLIO_GROWTH_SERVICE",
      "service": "newgrowthbusiness",
      "entrypoint": "PortfolioGrowthService",
      "remote": true
    }
  ]
}
