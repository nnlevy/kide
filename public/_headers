# Cloudflare Workers Assets serves static files BEFORE the Worker runs, so
# response headers for them belong here, not in src/worker/index.ts.

# The voice pack is versioned by directory (/voice/v1/…), so a new pack is a new
# path and these can cache for a year. This is what keeps the marginal cost of
# Pip talking at zero, and what lets the game keep speaking offline.
/voice/v1/*
  Cache-Control: public, max-age=31536000, immutable

# The generated registry and module are small and change with the game; a day is plenty.
/voice-manifest.js
  Cache-Control: public, max-age=86400

/voice.js
  Cache-Control: public, max-age=86400

# A legacy share link puts the practice record in ?data=. Same-origin subresources
# would otherwise send that query in Referer. Assets are served before the Worker,
# so the header has to live here. The page also moves ?data= into the fragment
# before it asks for a stylesheet.
/clinician
  Referrer-Policy: no-referrer

/clinician/
  Referrer-Policy: no-referrer

/clinician/*
  Referrer-Policy: no-referrer
